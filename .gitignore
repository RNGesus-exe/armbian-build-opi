### Specific to building Armbian ###
/.vagrant/
ubuntu-*-cloudimg-console.log

### to ignore changes in a working copy
.ignore_changes

### compile configurations added by users
/config-*.conf
### but not default (supplied) files
!/config-docker.conf
!/config-vagrant.conf

### output directories
/.tmp/
/output/
/cache/
/*userpatches*/
### but track this fork's x96q-v5-1 customizations (see README-x96q.md)
!/userpatches/
/userpatches/*
!/userpatches/customize-image.sh
!/userpatches/extensions/
!/userpatches/drivers/
!/userpatches/firmware/
### out-of-tree kernel module build output
/userpatches/drivers/**/*.o
/userpatches/drivers/**/*.ko
/userpatches/drivers/**/*.mod
/userpatches/drivers/**/*.mod.c
/userpatches/drivers/**/.*.cmd
/userpatches/drivers/**/Module.symvers
/userpatches/drivers/**/modules.order
### screen -L build log
/build-screen.log

### General annoyances ###
.DS_Store
*~
*.swp
/__pycache__/*

# Mainly generated by merge tools like 'meld'
*.orig

# Dockerfile and .dockerignore is generated by docker.sh
Dockerfile
.dockerignore
